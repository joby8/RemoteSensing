.DS_Store

# Raw ESMR data (5.6 GB, too large for GitHub)
ESMR_colocated_filtered/
*.nc

# Small land masks needed by the resampling example
!provided/resampling_example/*.nc

# Large reference books (copies on Google Drive)
docs/literature/*
!docs/literature/Antarctic Sea Ice 1973-1976 - NASA SP-459 - 1983 - Zwally.pdf

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
.venv/

# Generated results (re-creatable)
output/*
# except the globe page and one sample day (1 Feb, the day it opens on); the other days stay local
!output/globe/
output/globe/*
!output/globe/ESMR_globe.html
!output/globe/days/
output/globe/days/*
!output/globe/days/0201.js

# Large media
*.mp3
*.mp4
